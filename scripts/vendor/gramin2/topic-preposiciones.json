     "gloss": {
      "de": "Ich träume davon zu reisen.",
      "en": "I dream of traveling."
     },
     "note": {
      "de": "soñar con",
      "en": "soñar con"
     }
    },
    {
     "es": "Depende de ti.",
     "gloss": {
      "de": "Es hängt von dir ab.",
      "en": "It depends on you."
     },
     "note": {
      "de": "depender de",
      "en": "depender de"
     }
    }
   ]
  }
 ]
