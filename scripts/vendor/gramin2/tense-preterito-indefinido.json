 },
 "mood": {
  "de": "Indikativ",
  "en": "Indicative"
 },
 "summary": {
  "de": "Für abgeschlossene Handlungen in der Vergangenheit und für aufeinanderfolgende Ereignisse.",
  "en": "For completed past actions and for a sequence of events."
 },
 "rules": [
  {
   "title": {
    "de": "Wann benutzt man es",
    "en": "When to use it"
   },
   "body": {
    "de": "Für einzelne abgeschlossene Handlungen und für eine Kette von Ereignissen in der Vergangenheit.",
    "en": "For single completed actions and for a chain of events in the past."
   },
   "examples": [
    {
     "es": "Ayer hablé con mi madre.",
     "gloss": {
      "de": "Gestern sprach ich mit meiner Mutter.",
      "en": "Yesterday I spoke with my mother."
     },
     "note": {
      "de": "abgeschlossen",
      "en": "completed"
     }
    },
    {
     "es": "Comí, viví y dormí allí.",
     "gloss": {
      "de": "Ich aß, lebte und schlief dort.",
      "en": "I ate, lived and slept there."
     },
     "note": {
      "de": "Reihenfolge",
      "en": "sequence"
     }
    }
   ]
  },
  {
   "title": {
    "de": "Regelmäßige Endungen",
    "en": "Regular endings"
   },
   "body": {
