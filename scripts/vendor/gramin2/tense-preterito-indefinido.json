     "gloss": {
      "de": "Er/Sie lebte in Madrid.",
      "en": "He/She lived in Madrid."
     }
    }
   ]
  },
  {
   "title": {
    "de": "Starke unregelmäßige Stämme",
    "en": "Strong irregular stems"
   },
   "body": {
    "de": "Neuer Stamm plus betonungslose Endungen e, iste, o, imos, isteis, ieron (kein Akzent).",
    "en": "New stem plus unstressed endings e, iste, o, imos, isteis, ieron (no accent)."
   },
   "examples": [
