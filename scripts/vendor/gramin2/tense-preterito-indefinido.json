     "gloss": {
      "de": "Es war ein guter Tag.",
      "en": "It was a good day."
     },
     "note": {
      "de": "ser",
      "en": "ser"
     }
    },
    {
     "es": "El niño durmió bien.",
     "gloss": {
      "de": "Das Kind schlief gut.",
      "en": "The child slept well."
     },
     "note": {
      "de": "o wird u",
      "en": "o becomes u"
     }
    }
   ]
  },
  {
   "title": {
