     "gloss": {
      "de": "Wir waren zu Hause.",
      "en": "We were at home."
     },
     "note": {
      "de": "estar > estuv-",
      "en": "estar > estuv-"
     }
    },
    {
     "es": "No pude dormir.",
     "gloss": {
      "de": "Ich konnte nicht schlafen.",
      "en": "I couldn't sleep."
     },
     "note": {
      "de": "poder > pud-",
      "en": "poder > pud-"
     }
    }
   ]
  },
  {
   "title": {
    "de": "decir, hacer und querer",
    "en": "decir, hacer and querer"
   },
   "body": {
    "de": "dij- verliert das i in dijeron; hacer wird hizo (z); querer wird quis-.",
    "en": "dij- drops the i in dijeron; hacer becomes hizo (z); querer becomes quis-."
   },
   "examples": [
    {
     "es": "Me dijo la verdad.",
     "gloss": {
      "de": "Er/Sie sagte mir die Wahrheit.",
      "en": "He/She told me the truth."
     },
     "note": {
      "de": "decir > dij-",
      "en": "decir > dij-"
     }
    },
    {
     "es": "Hizo la cena.",
     "gloss": {
      "de": "Er/Sie machte das Abendessen.",
      "en": "He/She made dinner."
     },
     "note": {
      "de": "c wird z",
      "en": "c becomes z"
     }
    },
    {
     "es": "Quise ayudar.",
     "gloss": {
      "de": "Ich wollte helfen.",
      "en": "I wanted to help."
     },
     "note": {
      "de": "querer > quis-",
      "en": "querer > quis-"
     }
    }
   ]
  },
  {
   "title": {
    "de": "fui für ser/ir und ó>u",
    "en": "fui for ser/ir and ó>u"
   },
   "body": {
    "de": "ser und ir teilen fui, fue; -ir-Verben ändern in der 3. Person o zu u: durmió.",
    "en": "ser and ir share fui, fue; -ir verbs change o to u in the 3rd person: durmió."
   },
   "examples": [
    {
     "es": "Fui al cine.",
     "gloss": {
      "de": "Ich ging ins Kino.",
      "en": "I went to the cinema."
